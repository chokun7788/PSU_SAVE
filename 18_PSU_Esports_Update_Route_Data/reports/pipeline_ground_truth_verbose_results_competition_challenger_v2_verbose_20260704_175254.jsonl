{"no": 15, "id": "competition_challenger_v2_derived_015", "verdict": "PASS", "question": "ถ้าผู้เล่น เคาเตอร์ ถอนตัวทีมจะเป็นยังไง ขอคำตอบสั้นๆแต่ต้องอ้างอิงกติกา", "answer": "คำตอบ: ถ้าผู้เล่น CS2 ถอนตัว ทีมเสี่ยงถูกตัดสิทธิ์ตามเงื่อนไขของกติกา\nแหล่งข้อมูล: local://competition_rules/competition_rules_cs2_psu_phuket_2026", "ground_truth": {"id": "competition_challenger_v2_derived_015", "category": "competition_rules", "game": "Counter-Strike 2", "intent": "eligibility", "question": "ถ้าผู้เล่น เคาเตอร์ ถอนตัวทีมจะเป็นยังไง ขอคำตอบสั้นๆแต่ต้องอ้างอิงกติกา", "expected_keywords": ["ถอนตัว", "ตัดสิทธิ์"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "answer_type": "policy", "difficulty": "challenger", "variant_type": "derived_natural_language", "source_fact_key": "cs2_member_withdraw", "expected_mode_prefix": "pipeline:"}, "expected_keywords": ["ถอนตัว", "ตัดสิทธิ์"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "keyword_ok": true, "source_ok": true, "quality_ok": true, "matched_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "missing_keywords": [], "missing_source_keywords": [], "quality_problems": [], "validation_errors": [], "validation_warnings": [], "mode": "pipeline:competition_fact_card", "route_category": "competition_rules", "route_intent": "competition_rules_lookup", "confidence": 0.96, "latency_sec": 0.0191, "wall_sec": 0.0191, "sources": [{"id": "round5_cs2_member_withdraw", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026"}], "retrieved_ids": ["round5_cs2_member_withdraw"]}
