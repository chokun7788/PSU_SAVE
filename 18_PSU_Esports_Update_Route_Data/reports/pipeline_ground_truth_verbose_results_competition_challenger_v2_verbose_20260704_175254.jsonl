{"no": 18, "id": "competition_challenger_v2_derived_018", "verdict": "PASS", "question": "Counter Strike มาสายหรือไม่ยืนยันเข้าแข่งก่อนแมตช์เสี่ยงอะไร แบบตอบให้เอาไปบอกเพื่อนได้เลย", "answer": "คำตอบ: CS2 หากมาสายหรือไม่ยืนยันเข้าแข่งขันก่อนแมตช์ ทีมเสี่ยงถูกตัดสิทธิ์\n\nหลักฐานจากกติกา:\n- เพิ่มจากการ audit Ground Truth Challenger V2 เพื่อให้ตอบคำถามภาษาคนจริงได้ตรงประเด็นและไม่ดึง chunk ใกล้เคียงผิด\n\nอ้างอิงจากกติกา: Counter-Strike 2 / PSU Phuket CS2 2026 Tournament\nแหล่งข้อมูล: local://competition_rules/competition_rules_cs2_psu_phuket_2026", "ground_truth": {"id": "competition_challenger_v2_derived_018", "category": "competition_rules", "game": "Counter-Strike 2", "intent": "late_start", "question": "Counter Strike มาสายหรือไม่ยืนยันเข้าแข่งก่อนแมตช์เสี่ยงอะไร แบบตอบให้เอาไปบอกเพื่อนได้เลย", "expected_keywords": ["มาสาย", "ตัดสิทธิ์"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "answer_type": "policy", "difficulty": "challenger", "variant_type": "derived_natural_language", "source_fact_key": "cs2_late_may_disqualify", "expected_mode_prefix": "pipeline:"}, "expected_keywords": ["มาสาย", "ตัดสิทธิ์"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "keyword_ok": true, "source_ok": true, "quality_ok": true, "matched_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "missing_keywords": [], "missing_source_keywords": [], "quality_problems": [], "validation_errors": [], "validation_warnings": [], "mode": "pipeline:competition_fact_card", "route_category": "competition_rules", "route_intent": "competition_rules_lookup", "confidence": 0.96, "latency_sec": 0.0201, "wall_sec": 0.0202, "sources": [{"id": "round5_cs2_late_may_disqualify", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026"}], "retrieved_ids": ["round5_cs2_late_may_disqualify"]}
