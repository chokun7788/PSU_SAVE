{"no": 10, "id": "competition_challenger_cs2_010", "verdict": "PASS", "question": "CS2 ใช้บัคถ้าโดนจับได้มีโทษไร", "answer": "คำตอบ: CS2 ห้ามใช้บัค หากโดนจับได้อาจถูกปรับแพ้ในรอบหรือแมตช์ และกรณีร้ายแรงอาจถูกตัดสิทธิ์\n\nหลักฐานจากกติกา:\n- เพิ่มจาก regression audit Challenger V1 เพื่อให้คำถามภาษาสั้นมากยังได้คำตอบตรงประเด็น\n\nอ้างอิงจากกติกา: Counter-Strike 2 / PSU Phuket CS2 2026 Tournament\nแหล่งข้อมูล: local://competition_rules/competition_rules_cs2_psu_phuket_2026", "ground_truth": {"id": "competition_challenger_cs2_010", "category": "competition_rules", "game": "Counter-Strike 2", "intent": "penalty", "question": "CS2 ใช้บัคถ้าโดนจับได้มีโทษไร", "expected_keywords": ["ปรับแพ้", "รอบ", "แมตช์"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "answer_type": "policy", "difficulty": "hard", "variant_type": "weird_user_question", "source_fact_key": "cs2_bug_penalty", "expected_mode_prefix": "pipeline:"}, "expected_keywords": ["ปรับแพ้", "รอบ", "แมตช์"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "keyword_ok": true, "source_ok": true, "quality_ok": true, "matched_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "missing_keywords": [], "missing_source_keywords": [], "quality_problems": [], "validation_errors": [], "validation_warnings": [], "mode": "pipeline:competition_fact_card", "route_category": "competition_rules", "route_intent": "competition_rules_lookup", "confidence": 0.96, "latency_sec": 0.0105, "wall_sec": 0.0105, "sources": [{"id": "round6_regression_cs2_bug_penalty_v1", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026"}], "retrieved_ids": ["round6_regression_cs2_bug_penalty_v1"]}
{"no": 11, "id": "competition_challenger_cs2_011", "verdict": "PASS", "question": "CS2 ดูสตรีมไปด้วยตอนแข่งได้ไหม", "answer": "คำตอบ: 3. การดูสตรีม ห้ามผู้เล่นดูสตรีมสดระหว่างแข่ง\n\nรายละเอียดที่เกี่ยวข้อง:\n- หยุดเกมโดยไม่ได้รับอนุญาต\n- ดูสตรีมระหว่างแข่ง\n- ปรับแพ้ในรอบนั้น / ตัดสิทธิ์จากการแข่งขัน\n- 7. เวลาการแข่งขัน สายการแข่งขันจะประกาศล่วงหน้าอย่างน้อย 1 วัน ต้องยืนยันการเข้าแข่งขันก่อนเริ่มแมตช์ การมาสายอาจถูกตัดสิทธิ์\n- ตักเตือน → ปรับแพ้ในรอบนั้น → ตัดสิทธิ์\n\nอ้างอิงจากกติกา: Counter-Strike 2 / PSU Phuket CS2 2026 Tournament\nแหล่งข้อมูล: local://competition_rules/competition_rules_cs2_psu_phuket_2026", "ground_truth": {"id": "competition_challenger_cs2_011", "category": "competition_rules", "game": "Counter-Strike 2", "intent": "penalty", "question": "CS2 ดูสตรีมไปด้วยตอนแข่งได้ไหม", "expected_keywords": ["ดูสตรีม", "ปรับแพ้", "แมตช์"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "answer_type": "policy", "difficulty": "hard", "variant_type": "weird_user_question", "source_fact_key": "cs2_stream_snipe_penalty", "expected_mode_prefix": "pipeline:"}, "expected_keywords": ["ดูสตรีม", "ปรับแพ้", "แมตช์"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "keyword_ok": true, "source_ok": true, "quality_ok": true, "matched_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "missing_keywords": [], "missing_source_keywords": [], "quality_problems": [], "validation_errors": [], "validation_warnings": [], "mode": "pipeline:rag_direct_curated", "route_category": "competition_rules", "route_intent": "competition_rules_lookup", "confidence": 0.84, "latency_sec": 0.0173, "wall_sec": 0.0174, "sources": [{"id": "competition_rules_cs2_psu_phuket_2026_s54_c01", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026, competition_rules_cs2_psu_phuket_2026_s54_c01"}, {"id": "competition_rules_cs2_psu_phuket_2026