_psu_phuket_2026_s06_c01", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026, competition_rules_cs2_psu_phuket_2026_s06_c01"}, {"id": "competition_rules_cs2_psu_phuket_2026_s15_c01", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026, competition_rules_cs2_psu_phuket_2026_s15_c01"}], "retrieved_ids": ["competition_rules_cs2_psu_phuket_2026_s09_c01", "competition_rules_cs2_psu_phuket_2026_s06_c01", "competition_rules_cs2_psu_phuket_2026_s15_c01"]}
{"no": 13, "id": "competition_cs2_v2_013", "verdict": "PASS", "question": "CS2 เปลี่ยนสมาชิกทีมระหว่างทัวร์นาเมนต์ได้ไหม", "answer": "คำตอบ: 1. ต้องไม่มีการเปลี่ยนแปลงสมาชิกในทีมตลอดระยะเวลาการแข่งขัน\n\nอ้างอิงจากกติกา: Counter-Strike 2 / PSU Phuket CS2 2026 Tournament\nแหล่งข้อมูล: local://competition_rules/competition_rules_cs2_psu_phuket_2026", "ground_truth": {"id": "competition_cs2_v2_013", "category": "competition_rules", "game": "Counter-Strike 2", "intent": "roster_change", "question": "CS2 เปลี่ยนสมาชิกทีมระหว่างทัวร์นาเมนต์ได้ไหม", "expected_keywords": ["ไม่มีการเปลี่ยนแปลง", "สมาชิก"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "answer_type": "policy", "difficulty": "medium", "variant_type": "roster_change", "source_fact_key": "cs2_roster_lock", "expected_mode_prefix": "pipeline:"}, "expected_keywords": ["ไม่มีการเปลี่ยนแปลง", "สมาชิก"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "keyword_ok": true, "source_ok": true, "quality_ok": true, "matched_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "missing_keywords": [], "missing_source_keywords": [], "quality_problems": [], "validation_errors": [], "validation_warnings": [], "mode": "pipeline:rag_direct_curated", "route_category": "competition_rules", "route_intent": "competition_rules_lookup", "confidence": 0.84, "latency_sec": 0.0181, "wall_sec": 0.0182, "sources": [{"id": "competition_rules_cs2_psu_phuket_2026_s11_c01", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026, competition_rules_cs2_psu_phuket_2026_s11_c01"}, {"id": "competition_rules_cs2_psu_phuket_2026_s18_c01", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026, competition_rules_cs2_psu_phuket_2026_s18_c01"}, {"id": "competition_rules_cs2_psu_phuket_2026_s23_