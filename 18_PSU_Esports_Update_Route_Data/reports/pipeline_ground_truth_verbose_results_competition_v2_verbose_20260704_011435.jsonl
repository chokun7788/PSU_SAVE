{"no": 16, "id": "competition_cs2_v2_016", "verdict": "PASS", "question": "ผู้เล่น CS2 เล่นให้สองทีมได้ไหม", "answer": "คำตอบ: 4. ผู้เล่นสามารถลงแข่งในนามของทีมได้ทีมเดียวเท่านั้น\n\nรายละเอียดที่เกี่ยวข้อง:\n- 3. ผู้เล่นห้ามนำโน้ตหรือเอกสารเข้าไป แต่หัวหน้าทีม สามารถนำเข้าไปได้ และต้องให้เอกสารแก่กรรมการก่อนการแข่งขันทุกครั้ง\n- 2. คุณสมบัติของทีมและผู้เล่น\n\nอ้างอิงจากกติกา: Counter-Strike 2 / PSU Phuket CS2 2026 Tournament\nแหล่งข้อมูล: local://competition_rules/competition_rules_cs2_psu_phuket_2026", "ground_truth": {"id": "competition_cs2_v2_016", "category": "competition_rules", "game": "Counter-Strike 2", "intent": "eligibility", "question": "ผู้เล่น CS2 เล่นให้สองทีมได้ไหม", "expected_keywords": ["ทีมเดียว"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "answer_type": "policy", "difficulty": "medium", "variant_type": "eligibility", "source_fact_key": "cs2_one_team_only", "expected_mode_prefix": "pipeline:"}, "expected_keywords": ["ทีมเดียว"], "expected_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "keyword_ok": true, "source_ok": true, "quality_ok": true, "matched_source_keywords": ["competition_rules_cs2_psu_phuket_2026"], "missing_keywords": [], "missing_source_keywords": [], "quality_problems": [], "validation_errors": [], "validation_warnings": [], "mode": "pipeline:rag_direct_curated", "route_category": "competition_rules", "route_intent": "competition_rules_lookup", "confidence": 0.84, "latency_sec": 0.0191, "wall_sec": 0.0192, "sources": [{"id": "competition_rules_cs2_psu_phuket_2026_s14_c01", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_2026, competition_rules_cs2_psu_phuket_2026_s14_c01"}, {"id": "competition_rules_cs2_psu_phuket_2026_s16_c01", "url": "local://competition_rules/competition_rules_cs2_psu_phuket_2026", "category": "competition_rules", "source_ids": "competition_rules_cs2_psu_phuket_202